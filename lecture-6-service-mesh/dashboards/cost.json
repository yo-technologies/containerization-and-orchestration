{
  "uid": "itmo-shop-cost",
  "title": "ЛР6 — Baseline и цена mesh",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "itmo",
    "lab6"
  ],
  "timezone": "Europe/Moscow",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "p50 заказа: 2000 запросов, concurrency=4",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab6_benchmark{measurement=\"p50_ms\"}",
          "legendFormat": "{{stage}}",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Зафиксированные измерения scripts/benchmark.py: kubelet stats/summary и внутрикластерный клиент. Исходные данные в evidence/."
    },
