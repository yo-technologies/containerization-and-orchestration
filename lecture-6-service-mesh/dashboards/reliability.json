{
  "uid": "itmo-shop-reliability",
  "title": "ЛР6 — Надёжность без изменений клиента",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "itmo",
    "lab6"
  ],
  "timezone": "Europe/Moscow",
  "refresh": "5s",
  "time": {
    "from": "2026-10-29T23:06:35.851684+00:00",
    "to": "2026-10-29T23:09:03.980856+00:00"
  },
  "panels": [
    {
      "id": 1,
      "title": "FLAKY=30%: backend ошибается, клиент защищён",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(shop_http_requests_total{namespace=\"mesh-shop\",route=\"/order\",code=\"500\"}[30s])) / sum(rate(shop_http_requests_total{namespace=\"mesh-shop\",route=\"/order\"}[30s]))",
          "legendFormat": "Backend 500 / все попытки"
        },
        {
          "refId": "B",
          "expr": "(sum(rate(lab6_client_requests_total{phase=\"reliability\",code!~\"2..\"}[30s])) or vector(0)) / sum(rate(lab6_client_requests_total{phase=\"reliability\"}[30s]))",
          "legendFormat": "Ошибки клиента / заказы"
        },
        {
          "refId": "C",
          "expr": "sum(rate(envoy_cluster_upstream_rq_retry[30s])) / sum(rate(lab6_client_requests_total{phase=\"reliability\"}[30s]))",
          "legendFormat": "Повторы Envoy / заказ"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}