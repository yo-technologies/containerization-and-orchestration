{
  "uid": "shop-lab4",
  "title": "ЛР4 — заказы под перегрузкой",
  "tags": [
    "lab4",
    "shop"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "POST /order: p95 и граница 300 мс",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum by(le)(rate(shop_http_request_duration_seconds_bucket{namespace=\"__NAMESPACE__\",service=\"__API_SERVICE__\",route=\"/order\"}[1m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "drawStyle": "line",
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Оценка по серверной histogram за 1 минуту. Итог контрольного SLA проверяется клиентом k6."
    },
    {
      "id": 2,
      "title": "Ошибки POST /order: граница 0,5%",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "(sum(rate(shop_http_requests_total{namespace=\"__NAMESPACE__\",service=\"__API_SERVICE__\",route=\"/order\",method=\"POST\",code!=\"201\"}[1m])) or vector(0)) / sum(rate(shop_http_requests_total{namespace=\"__NAMESPACE__\",service=\"__API_SERVICE__\",route=\"/order\",method=\"POST\"}[1m])) * 100",
          "legendFormat": "Ответы не 201",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "drawStyle": "line",
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Серверная доля ошибок. При отсутствии запросов данных нет; сетевые ошибки до сервера учитывает k6."
    },
    {
      "id": 3,
      "title": "Частота создания заказов",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(shop_http_requests_total{namespace=\"__NAMESPACE__\",service=\"__API_SERVICE__\",route=\"/order\",method=\"POST\"}[1m]))",
          "legendFormat": "POST /order",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": ""
    },
    {
      "id": 4,
      "title": "Очередь: граница алерта 10",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(shop_pending_orders{namespace=\"__NAMESPACE__\"})",
          "legendFormat": "Не обработано",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "drawStyle": "line",
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Общая очередь БД; max вместо суммы копий одной метрики от worker."
    },
    {
      "id": 5,
      "title": "Готовность критического пути",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_ready{namespace=\"__NAMESPACE__\",pod=~\"__RELEASE__-api-.*\",condition=\"true\"})",
          "legendFormat": "API Ready",
          "refId": "A"
        },
        {
          "expr": "max(kube_pod_status_ready{namespace=\"__NAMESPACE__\",pod=\"__RELEASE__-postgres-1\",condition=\"true\"})",
          "legendFormat": "PostgreSQL Ready",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": ""
    },
    {
      "id": 6,
      "title": "Batch: кто не поместился",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{namespace=\"__NAMESPACE__\",pod=~\"__RELEASE__-batch-.*\",phase=\"Pending\"})",
          "legendFormat": "Pending",
          "refId": "A"
        },
        {
          "expr": "sum(kube_pod_status_phase{namespace=\"__NAMESPACE__\",pod=~\"__RELEASE__-batch-.*\",phase=\"Running\"})",
          "legendFormat": "Running",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": ""
    },
    {
      "id": 7,
      "title": "Давление памяти на нодах",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by(node)(kube_node_status_condition{condition=\"MemoryPressure\",status=\"true\"})",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "MemoryPressure=1: kubelet наблюдает давление памяти. Это не признак OOM по собственному лимиту Pod."
    },
    {
      "id": 8,
      "title": "Три алерта shop",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by(alertname,alertstate)(ALERTS{alertname=~\"ShopAPIUnavailable|ShopDatabaseUnavailable|ShopOrderBacklog\"})",
          "legendFormat": "{{alertname}} · {{alertstate}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Показывает только Pending/Firing. Отсутствие серий при здоровом сервисе нормально."
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true
}
